<?xml version="1.0" encoding="UTF-8"?>
<!--
  This file is part of the DSView project.
  Copyright (C) 2026 Schildkroet

  DSView capture files (*.dsl). They are zip archives. The extension is the
  same as for DSSSL stylesheets (text/x-dsl), so the zip header tells the two
  apart, and the desktop entry claims only this type.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-dsview-capture">
    <comment>DSView capture</comment>
    <sub-class-of type="application/zip"/>
    <generic-icon name="application-x-generic"/>
    <glob pattern="*.dsl"/>
    <magic priority="60">
      <match type="string" offset="0" value="PK\003\004"/>
    </magic>
  </mime-type>
</mime-info>
