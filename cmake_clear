#!/bin/sh
# Remove build output. All builds now go to ./build (in-source builds are
# rejected by CMakeLists.txt); this also clears leftovers from older
# in-source builds. Run with sudo if some files are root-owned.

cd "$(dirname "$0")" || exit 1

echo "clean build output begin..."

rm -rf ./build ./build.dir

# leftovers of in-source builds (source root)
rm -rf ./CMakeFiles ./_CPack_Packages
rm -f ./CMakeCache.txt ./Makefile ./Makefile.tmp ./cmake_install.cmake \
      ./CPackConfig.cmake ./CPackSourceConfig.cmake ./install_manifest.txt \
      ./qrc_*.cpp ./DSView/config.h

# generated sources scattered through the tree by in-source builds
find ./DSView ./common ./libsigrok4DSL ./libsigrokdecode4DSL \
    \( -name 'moc_*.cpp' -o -name 'moc_*.cpp_parameters' -o -name '*.qrc.depends' \) \
    -exec rm -f {} +

echo "clean build output end."
